@page "/scan"
@layout vehicleManagement.Components.Layouts.MobileLayout
@attribute [Authorize(Roles = vehicleManagement.DAL.Model.Roles.User)]

<PageTitle>扫码登记 · 车辆管理系统</PageTitle>

@* 使用人员登录后的落脚点（/m/login 登录无 returnUrl 时）。
   本页不查任何数据，也不提供任何后台入口。 *@

<div style="padding:32px 20px;text-align:center;">
    <div style="font-size:44px;line-height:1;margin-bottom:16px;">■</div>
    <h2 style="margin:0 0 10px;font-size:18px;font-weight:600;color:var(--text-primary,#373737);">请扫描车辆上的二维码</h2>
    <p style="margin:0 0 24px;font-size:14px;line-height:1.8;color:var(--text-secondary,#8E8E8E);">
        已登录：<strong>@UserName</strong><br />
        每个车辆二维码对应一辆车，扫码后即可登记本次用车。
    </p>

    <p style="margin:0;font-size:13px;line-height:1.8;color:var(--text-secondary,#8E8E8E);">
        退出登录请用页面顶栏的按钮。
    </p>
</div>

@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthState { get; set; }

    private string UserName { get; set; } = "";

    protected override async Task OnInitializedAsync()
    {
        if (AuthState is null)
            return;

        var state = await AuthState;
        UserName = state.User.Identity?.Name ?? "";
    }
}
