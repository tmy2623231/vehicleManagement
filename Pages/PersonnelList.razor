@page "/personnel"
@attribute [Authorize(Roles = vehicleManagement.DAL.Model.Roles.BackOffice)]
@inject PersonnelService PersonService
@inject AccountService AccountSvc
@using PersonnelEntity = vehicleManagement.DAL.Model.Personnel

<div class="flex justify-between items-center mb-5">
    <div>
        <h2 class="text-xl font-bold text-dark">人员管理</h2>
        <p class="text-sm text-gray mt-1">管理人员信息和部门分配</p>
    </div>
    <div class="flex items-center gap-3">
        <input class="input-field" type="text" style="width:260px" placeholder="搜索姓名/联系方式..."
               value="@searchKeyword" @oninput="OnSearchInput" />
        <button class="btn btn-primary" @onclick="ShowAddForm">+ 新增人员</button>
    </div>
</div>

<!-- 新增/编辑弹框 -->
@if (showForm)
{
    <div class="modal-overlay show" @onclick="CancelForm">
        <div class="modal" @onclick:stopPropagation>
            <div class="modal-header">
                <div class="modal-title">@(editId == 0 ? "新增人员" : "编辑人员")</div>
                <button class="modal-close" @onclick="CancelForm">✕</button>
            </div>
            <div>
                <div class="grid grid-2 mb-4">
                    <div>
                        <label class="input-label">所属部门</label>
                        <select class="input-field" @bind="formDeptId">
                            <option value="0">-- 请选择 --</option>
                            @foreach (var d in allDepartments)
                            {
                                <option value="@d.Id">@d.Name</option>
                            }
                        </select>
                    </div>
                    <div>
                        <label class="input-label">姓名</label>
                        <input class="input-field" type="text" placeholder="请输入姓名" @bind="formName" />
                    </div>
                </div>
                <div class="grid grid-2 mb-4">
                    <div>
                        <label class="input-label">联系方式</label>
                        <input class="input-field" type="text" placeholder="请输入联系电话" @bind="formPhone" />
                    </div>
                    <div style="display:flex;align-items:flex-end;padding-bottom:4px;">
                        <label class="input-label" style="cursor:pointer">
                            <input type="checkbox" @bind="formIsActive" style="width:16px;height:16px;" />
                            <span>在职</span>
                        </label>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" @onclick="CancelForm">取消</button>
                <button class="btn btn-primary" @onclick="Save">保存</button>
            </div>
        </div>
    </div>
}

<!-- 删除确认弹框 -->
@if (showDeleteConfirm)
{
    <div class="modal-overlay show" @onclick="CloseDeleteConfirm">
        <div class="modal" style="max-width:420px" @onclick:stopPropagation>
            <div class="modal-header">
                <div class="modal-title">确认删除</div>
                <button class="modal-close" @onclick="CloseDeleteConfirm">✕</button>
            </div>
            <p style="color:var(--gray-700);font-size:15px;line-height:1.6;">
                确定要删除人员 <strong class="text-dark">@deletingPersonName</strong> 吗？<br/>
                <span class="text-sm text-gray">此操作不可恢复。</span>
            </p>
            <div class="modal-footer">
                <button class="btn btn-secondary" @onclick="CloseDeleteConfirm">取消</button>
                <button class="btn btn-danger" @onclick="ConfirmDelete">确认删除</button>
            </div>
        </div>
    </div>
}

<!-- 错误提示弹框 -->
@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="modal-overlay show" @onclick="CloseError">
        <div class="modal" style="max-width:420px" @onclick:stopPropagation>
            <div class="modal-header">
                <div class="modal-title">操作失败</div>
                <button class="modal-close" @onclick="CloseError">✕</button>
            </div>
            <p style="color:var(--red-600);font-size:15px;line-height:1.6;">@errorMessage</p>
            <div class="modal-footer">
                <button class="btn btn-primary" @onclick="CloseError">确定</button>
            </div>
        </div>
    </div>
}

<!-- 账号弹框：开通账号 / 重置密码 -->
@if (showAccountForm)
{
    <div class="modal-overlay show" @onclick="CloseAccountForm">
        <div class="modal" style="max-width:460px" @onclick:stopPropagation>
            <div class="modal-header">
                <div class="modal-title">@(accountIsCreate ? "开通账号" : "重置密码")</div>
                <button class="modal-close" @onclick="CloseAccountForm">✕</button>
            </div>
            <div>
                <p class="text-sm text-gray mb-4">人员：<strong class="text-dark">@accountPersonnelName</strong></p>
                @if (accountIsCreate)
                {
                    <div class="mb-4">
                        <label class="input-label">登录用户名</label>
                        <input class="input-field" type="text" placeholder="小写字母开头，字母或数字 3-20 位"
                               @bind="accountUserName" @bind:event="oninput" />
                    </div>
                }
                else
                {
                    <p class="text-sm text-gray mb-4">登录名：<strong class="text-dark">@accountUserName</strong></p>
                }
                <div>
                    <label class="input-label">@(accountIsCreate ? "初始密码" : "新密码")</label>
                    <input class="input-field" type="text" placeholder="至少 6 位"
                           @bind="accountPassword" @bind:event="oninput" />
                </div>
                @if (!string.IsNullOrEmpty(accountError))
                {
                    <p class="text-sm mt-3" style="color:var(--red-600);">@accountError</p>
                }
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" @onclick="CloseAccountForm">取消</button>
                <button class="btn btn-primary" @onclick="SaveAccount" disabled="@accountSaving">
                    @(accountSaving ? "提交中..." : "确定")
                </button>
            </div>
        </div>
    </div>
}

<!-- 删除账号确认弹框：与「删除人员」分开，不塞进账号表单弹框 -->
@if (showAccountDeleteConfirm)
{
    <div class="modal-overlay show" @onclick="CloseAccountDeleteConfirm">
        <div class="modal" style="max-width:440px" @onclick:stopPropagation>
            <div class="modal-header">
                <div class="modal-title">确认删除账号</div>
                <button class="modal-close" @onclick="CloseAccountDeleteConfirm">✕</button>
            </div>
            <p style="color:var(--gray-700);font-size:15px;line-height:1.6;">
                确定要删除 <strong class="text-dark">@deletingAccountName</strong>（登录名 <strong class="text-dark">@deletingAccountUserName</strong>）吗？<br/>
                <span class="text-sm text-gray">删除后该人员将无法登录扫码页，可重新「开通账号」恢复；历史审计日志保留。</span>
            </p>
            <div class="modal-footer">
                <button class="btn btn-secondary" @onclick="CloseAccountDeleteConfirm">取消</button>
                <button class="btn btn-danger" @onclick="ConfirmDeleteAccount" disabled="@accountSaving">
                    @(accountSaving ? "删除中..." : "确认删除")
                </button>
            </div>
        </div>
    </div>
}

<div class="card">
    <div class="card-header">
        <div>
            <div class="card-title">人员列表</div>
            <div class="card-subtitle">共 @totalCount 名人员</div>
        </div>
    </div>
    <div class="table-wrapper">
    <table>
        <thead>
            <tr>
                <th>所属部门</th>
                <th style="cursor:pointer" @onclick="@(() => ToggleSort("name"))">
                    姓名 @SortIndicator("name")
                </th>
                <th style="cursor:pointer" @onclick="@(() => ToggleSort("phone"))">
                    联系方式 @SortIndicator("phone")
                </th>
                <th>状态</th>
                <th>账号</th>
                <th style="cursor:pointer" @onclick="@(() => ToggleSort("created"))">
                    创建时间 @SortIndicator("created")
                </th>
                <th>操作</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var p in personnelList)
            {
                <tr>
                    <td>@(p.Department?.Name ?? "-")</td>
                    <td>@p.Name</td>
                    <td>@p.Phone</td>
                    <td>
                        @if (p.IsActive)
                        {
                            <span class="badge badge-green">在职</span>
                        }
                        else
                        {
                            <span class="badge badge-gray">离职</span>
                        }
                    </td>
                    <td>
                        @{
                            var account = accounts.TryGetValue(p.Id, out var acc) ? acc : null;
                        }
                        @if (account == null)
                        {
                            <span class="text-sm text-gray">未开通</span>
                        }
                        else if (account.IsActive)
                        {
                            <span class="badge badge-green">@account.UserName</span>
                        }
                        else
                        {
                            <span class="badge badge-gray">@account.UserName（已禁用）</span>
                        }
                    </td>
                    <td>@p.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                    <td>
                        <div class="flex gap-2">
                            @if (accounts.TryGetValue(p.Id, out var rowAccount) && rowAccount != null)
                            {
                                <button class="btn btn-sm btn-secondary" @onclick="() => ShowResetPassword(p)">重置密码</button>
                                <button class="btn btn-sm btn-danger" @onclick="() => ShowDeleteAccount(p, rowAccount)">删除账号</button>
                            }
                            else
                            {
                                <button class="btn btn-sm btn-secondary" @onclick="() => ShowCreateAccount(p)">开通账号</button>
                            }
                            <button class="btn btn-sm btn-info" @onclick="() => Edit(p)">编辑</button>
                            <button class="btn btn-sm btn-danger" @onclick="() => ShowDeleteConfirm(p.Id, p.Name)">删除</button>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    </div>
</div>

<Pagination CurrentPage="currentPage" TotalPages="totalPages" TotalCount="totalCount" OnPageChanged="OnPageChanged" />

@code {
    // ===== UI 状态变量 =====
    private List<PersonnelEntity> personnelList = new();
    private List<Department> allDepartments = new();
    private bool showForm = false;
    private int editId = 0;
    private int formDeptId = 0;
    private string formName = "";
    private string formPhone = "";
    private bool formIsActive = true;
    private string errorMessage = null;
    private bool showDeleteConfirm = false;
    private int deletingPersonId = 0;
    private string deletingPersonName = "";

    // ===== 账号管理（人员 → 账号） =====
    private Dictionary<int, AppUser> accounts = new();
    private bool showAccountForm = false;
    private bool accountIsCreate = true;
    private int accountPersonnelId = 0;
    private int accountUserId = 0;
    private string accountPersonnelName = "";
    private string accountUserName = "";
    private string accountPassword = "";
    private string accountError = "";
    private bool accountSaving = false;

    // ===== 删除账号确认状态 =====
    private bool showAccountDeleteConfirm = false;
    private int deletingAccountUserId = 0;
    private string deletingAccountUserName = "";
    private string deletingAccountName = "";

    // ===== 分页/搜索/排序状态 =====
    private int currentPage = 1;
    private int pageSize = 10;
    private int totalCount = 0;
    private int totalPages => totalCount > 0 ? (int)Math.Ceiling((double)totalCount / pageSize) : 1;
    private string searchKeyword = "";
    private string sortColumn = "created";
    private bool sortAscending = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    /// <summary>
    /// 加载人员分页数据（委托给 PersonnelService）
    /// </summary>
    private async Task LoadData()
    {
        allDepartments = await PersonService.GetAllDepartmentsAsync();
        var result = await PersonService.GetPagedAsync(searchKeyword, sortColumn, sortAscending, currentPage, pageSize);
        personnelList = result.Items;
        totalCount = result.TotalCount;
        currentPage = result.CurrentPage;

        // 账号列：一次性批量取，避免每行一次查询
        accounts = await AccountSvc.GetAccountsByPersonnelAsync(personnelList.Select(p => p.Id));
    }

    // ===== 账号管理操作 =====
    private void ShowCreateAccount(PersonnelEntity p)
    {
        accountIsCreate = true;
        accountPersonnelId = p.Id;
        accountUserId = 0;
        accountPersonnelName = p.Name;
        accountUserName = "";
        accountPassword = "123456";   // 与存量播种的初始口令保持一致
        accountError = "";
        showAccountForm = true;
    }

    private void ShowResetPassword(PersonnelEntity p)
    {
        if (!accounts.TryGetValue(p.Id, out var account) || account == null) return;

        accountIsCreate = false;
        accountPersonnelId = p.Id;
        accountUserId = account.Id;
        accountPersonnelName = p.Name;
        accountUserName = account.UserName;
        accountPassword = "";
        accountError = "";
        showAccountForm = true;
    }

    private void CloseAccountForm()
    {
        showAccountForm = false;
        accountError = "";
    }

    private void ShowDeleteAccount(PersonnelEntity p, AppUser account)
    {
        deletingAccountUserId = account.Id;
        deletingAccountUserName = account.UserName;
        deletingAccountName = p.Name;
        showAccountDeleteConfirm = true;
    }

    private void CloseAccountDeleteConfirm()
    {
        showAccountDeleteConfirm = false;
        deletingAccountUserId = 0;
    }

    private async Task ConfirmDeleteAccount()
    {
        accountSaving = true;
        try
        {
            var (ok, err) = await AccountSvc.DeleteAccountAsync(deletingAccountUserId);
            if (!ok) { errorMessage = err; }
            CloseAccountDeleteConfirm();
            if (ok) await LoadData();
        }
        finally { accountSaving = false; }
    }

    private async Task SaveAccount()
    {
        accountError = "";
        accountSaving = true;
        try
        {
            var (success, errorMsg) = accountIsCreate
                ? await AccountSvc.CreateAccountAsync(accountPersonnelId, accountUserName, accountPassword)
                : await AccountSvc.ResetPasswordAsync(accountUserId, accountPassword);

            if (!success)
            {
                accountError = errorMsg;
                return;
            }

            showAccountForm = false;
            await LoadData();
        }
        finally
        {
            accountSaving = false;
        }
    }

    private async Task OnPageChanged(int page)
    {
        currentPage = page;
        await LoadData();
    }

    private async Task OnSearchInput(ChangeEventArgs e)
    {
        searchKeyword = e.Value?.ToString() ?? "";
        currentPage = 1;
        await LoadData();
    }

    private void ToggleSort(string column)
    {
        if (sortColumn == column)
            sortAscending = !sortAscending;
        else
        {
            sortColumn = column;
            sortAscending = true;
        }
        // 有意 fire-and-forget：ToggleSort 是同步 void，改 Task 只会把异常升级成断电路
        _ = LoadData();
    }

    private string SortIndicator(string column)
    {
        if (sortColumn != column) return "";
        return sortAscending ? "▲" : "▼";
    }

    private void ShowAddForm()
    {
        editId = 0;
        formDeptId = 0;
        formName = "";
        formPhone = "";
        formIsActive = true;
        showForm = true;
    }

    private void Edit(PersonnelEntity p)
    {
        editId = p.Id;
        formDeptId = p.DepartmentId;
        formName = p.Name;
        formPhone = p.Phone ?? "";
        formIsActive = p.IsActive;
        showForm = true;
    }

    private void CancelForm() => showForm = false;

    /// <summary>
    /// 保存人员（新增/编辑），委托给 PersonnelService
    /// </summary>
    private async Task Save()
    {
        if (string.IsNullOrWhiteSpace(formName) || formDeptId == 0) return;

        try
        {
            if (editId == 0)
            {
                await PersonService.CreateAsync(formDeptId, formName, formPhone, formIsActive);
            }
            else
            {
                await PersonService.UpdateAsync(editId, formDeptId, formName, formPhone, formIsActive);
            }

            showForm = false;
            await LoadData();
        }
        catch (Exception ex)
        {
            errorMessage = $"保存失败：{ex.Message}";
        }
    }

    private void ShowDeleteConfirm(int id, string name)
    {
        deletingPersonId = id;
        deletingPersonName = name;
        showDeleteConfirm = true;
    }

    private void CloseDeleteConfirm()
    {
        showDeleteConfirm = false;
        deletingPersonId = 0;
        deletingPersonName = "";
    }

    private void CloseError()
    {
        errorMessage = null;
    }

    /// <summary>
    /// 确认删除人员，委托给 PersonnelService（含业务校验）
    /// </summary>
    private async Task ConfirmDelete()
    {
        showDeleteConfirm = false;
        errorMessage = null;

        var (success, errorMsg) = await PersonService.DeleteAsync(deletingPersonId);
        if (!success)
        {
            errorMessage = errorMsg;
            return;
        }

        await LoadData();
    }
}
