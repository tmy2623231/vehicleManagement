@page "/borrow/{VehicleId:int}"
@attribute [Authorize(Roles = vehicleManagement.DAL.Model.Roles.Admin)]
@inject VehicleService VehicleService
@inject ExecuteService ExecService
@inject FileUploadService FileUploadService
@inject LocationService LocationService
@inject NavigationManager Nav
@inject ILogger<BorrowForm> Logger

<div class="flex justify-between items-center mb-5">
    <div>
        <h2 class="text-xl font-bold text-dark">借车登记</h2>
        <p class="text-sm text-gray mt-1">登记车辆借用信息</p>
    </div>
    <button class="btn btn-secondary" @onclick="GoToVehicles">← 返回车辆列表</button>
</div>

@if (loading)
{
    <div style="text-align:center;padding:40px;color:var(--gray-500);">加载中...</div>
}
else if (vehicle == null)
{
    <div style="text-align:center;padding:40px;color:var(--gray-500);">未找到车辆信息</div>
}
else if (saved)
{
    <div style="text-align:center;padding:60px 20px;">
        <div style="font-size:48px;color:var(--primary-600);margin-bottom:16px;">✓</div>
        <div style="font-size:18px;font-weight:600;color:var(--dark);margin-bottom:8px;">借车记录已保存</div>
        <div style="color:var(--gray-500);margin-bottom:20px;">车辆 @vehicle.LicensePlate 的借车信息已成功登记</div>
        <div style="display:flex;gap:12px;justify-content:center;">
            <button class="btn btn-primary" @onclick="ResetAsync">继续登记</button>
            <button class="btn btn-secondary" @onclick="GoToVehicles">返回车辆列表</button>
        </div>
    </div>
}
else
{
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:20px;">
        <div class="card">
            <div class="card-header">
                <div class="card-title">车辆信息</div>
            </div>
            <div style="padding:0 20px 20px;">
                <div style="display:flex;flex-direction:column;gap:12px;">
                    <div><span style="color:var(--gray-600);font-size:13px;">车牌号</span><div style="font-weight:600;font-size:18px;color:var(--dark);">@vehicle.LicensePlate</div></div>
                    <div><span style="color:var(--gray-600);font-size:13px;">所属部门</span><div style="font-weight:500;">@(vehicle.Department?.Name ?? "-")</div></div>
                    <div><span style="color:var(--gray-600);font-size:13px;">品牌/型号</span><div style="font-weight:500;">@vehicle.Brand @vehicle.Model</div></div>
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-header">
                <div class="card-title">借车登记信息</div>
            </div>
            <div style="padding:0 20px 20px;">
                <div class="grid grid-1 mb-4">
                    <div>
                        <label class="input-label">所属部门 <span style="color:var(--red-600)">*</span></label>
                        <select class="input-field" value="@selectedDeptId" @onchange="OnDeptChanged">
                            <option value="0">-- 请选择 --</option>
                            @foreach (var d in allDepartments)
                            {
                                <option value="@d.Id">@d.Name</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="grid grid-1 mb-4">
                    <div>
                        <label class="input-label">使用人员 <span style="color:var(--red-600)">*</span></label>
                        <select class="input-field" @bind="selectedPersonnelId">
                            <option value="0">-- 请选择部门 --</option>
                            @foreach (var p in filteredPersonnel)
                            {
                                <option value="@p.Id">@p.Name (@p.Phone)</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="mb-4">
                    <label class="input-label">途经路径点 <span style="color:var(--red-600)">*</span>（按顺序点选，可多选）</label>
                    <div style="display:flex;flex-wrap:wrap;gap:6px;margin-bottom:8px;min-height:28px;">
                        @if (selectedWaypoints.Any())
                        {
                            @for (int i = 0; i < selectedWaypoints.Count; i++)
                            {
                                var wp = selectedWaypoints[i];
                                <span class="badge badge-green" style="cursor:pointer;" @onclick="() => RemoveWaypoint(wp.Id)">@(i + 1). @wp.Name ×</span>
                            }
                        }
                        else { <span style="color:var(--gray-400);font-size:13px;">请点击下方选项添加</span> }
                    </div>
                    <div style="display:flex;flex-wrap:wrap;gap:6px;">
                        @foreach (var wp in allWaypoints)
                        {
                            var sel = selectedWaypoints.Any(s => s.Id == wp.Id);
                            <button class="btn btn-sm @(sel ? "btn-primary" : "btn-outline")" style="font-size:12px;" @onclick="() => ToggleWaypoint(wp)">@wp.Name</button>
                        }
                    </div>
                </div>
                <div class="grid grid-1 mb-4">
                    <div>
                        <label class="input-label">最终停车位置 <span style="color:var(--red-600)">*</span></label>
                        <select class="input-field" @bind="selectedFinalLocationId">
                            <option value="0">-- 请选择 --</option>
                            @foreach (var loc in allFinalLocations)
                            {
                                <option value="@loc.Id">@loc.Name</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="grid grid-2 mb-4" style="gap:12px;">
                    <div>
                        <label class="input-label">起始里程 (km)</label>
                        <input class="input-field" type="number" step="0.1" placeholder="0.0" @bind="mileageStart" />
                    </div>
                    <div>
                        <label class="input-label">结束里程 (km)</label>
                        <input class="input-field" type="number" step="0.1" placeholder="0.0" @bind="mileageEnd" />
                    </div>
                </div>
                <div class="grid grid-1 mb-4">
                    <div>
                        <label class="input-label">备注</label>
                        <input class="input-field" type="text" placeholder="备注信息（可选）" @bind="remarks" />
                    </div>
                </div>
                <div class="mb-4">
                    <label class="input-label">上传附件</label>
                    <InputFile OnChange="OnFileSelected" multiple accept="image/*,video/*" disabled="@uploading" />
                    @if (uploading) { <div style="color:var(--primary-600);margin-top:4px;">上传中...</div> }
                    @if (uploadedFiles.Any())
                    {
                        <div style="margin-top:4px;">
                            @foreach (var f in uploadedFiles) { <span class="badge badge-green" style="margin-right:4px;">@System.IO.Path.GetFileName(f)</span> }
                        </div>
                    }
                </div>
                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div style="color:var(--red-600);margin-bottom:12px;font-size:14px;">@errorMessage</div>
                }
                <button class="btn btn-primary" style="width:100%;" @onclick="Save" disabled="@(saving || uploading)">@(saving ? "保存中..." : "保存借车记录")</button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public int VehicleId { get; set; }

    private bool loading = true;
    private bool saving = false;
    private bool saved = false;
    private bool uploading = false;
    private Vehicle vehicle;
    private List<Department> allDepartments = new();
    private List<Personnel> filteredPersonnel = new();
    private List<Location> allWaypoints = new();
    private List<Location> allFinalLocations = new();
    private List<Location> selectedWaypoints = new();
    private List<string> uploadedFiles = new();

    private int selectedDeptId = 0;
    private int selectedPersonnelId = 0;
    private int selectedFinalLocationId = 0;
    private double? mileageStart;
    private double? mileageEnd;
    private string remarks = "";
    private string errorMessage = "";

    private void GoToVehicles() => Nav.NavigateTo("/vehicles");

    private int loadedVehicleId;

    /// <summary>VehicleId 变化（换一辆车）必须按新车辆重算预填，不能沿用上一辆车的旧值</summary>
    protected override async Task OnParametersSetAsync()
    {
        if (loadedVehicleId == VehicleId) return;
        loadedVehicleId = VehicleId;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        loading = true;
        vehicle = await VehicleService.GetVehicleByIdAsync(VehicleId);
        allDepartments = await VehicleService.GetAllDepartmentsAsync();
        allWaypoints = await LocationService.GetActiveWaypointsAsync();
        allFinalLocations = await LocationService.GetActiveFinalLocationsAsync();
        // 起始里程预填该车最近一次结束里程：只是默认值，仍可手工改写；无历史则保持为空
        mileageStart = await ExecService.GetLastMileageEndAsync(VehicleId);
        loading = false;
    }

    private async Task OnDeptChanged(ChangeEventArgs e)
    {
        selectedDeptId = int.Parse(e.Value?.ToString() ?? "0");
        selectedPersonnelId = 0;
        if (selectedDeptId > 0)
            filteredPersonnel = await VehicleService.GetPersonnelByDepartmentAsync(selectedDeptId);
        else
            filteredPersonnel = new();
    }

    private void ToggleWaypoint(Location wp)
    {
        var existing = selectedWaypoints.FirstOrDefault(s => s.Id == wp.Id);
        if (existing != null) selectedWaypoints.Remove(existing);
        else selectedWaypoints.Add(wp);
    }

    private void RemoveWaypoint(int id)
    {
        selectedWaypoints.RemoveAll(s => s.Id == id);
    }

    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        uploading = true;
        errorMessage = "";
        var deptName = vehicle?.Department?.Name ?? "未知部门";
        var plate = vehicle?.LicensePlate ?? "未知车牌";
        var personName = selectedPersonnelId > 0 ? filteredPersonnel.FirstOrDefault(p => p.Id == selectedPersonnelId)?.Name ?? "未知人员" : "未知人员";

        foreach (var file in e.GetMultipleFiles(15))
        {
            try
            {
                var path = await FileUploadService.UploadFileAsync(file, deptName, plate, personName);
                uploadedFiles.Add(path);
            }
            catch (Exception ex) { errorMessage = $"上传失败：{ex.Message}"; }
        }
        uploading = false;
    }

    private async Task Save()
    {
        errorMessage = "";
        if (selectedPersonnelId == 0) { errorMessage = "请选择使用人员"; return; }
        if (!selectedWaypoints.Any()) { errorMessage = "请选择至少一个途经路径点"; return; }
        if (selectedFinalLocationId == 0) { errorMessage = "请选择最终停车位置"; return; }

        saving = true;
        try
        {
            var request = new SaveUsageRecordRequest
            {
                VehicleId = VehicleId,
                DepartmentId = selectedDeptId,
                PersonnelId = selectedPersonnelId,
                WaypointIds = selectedWaypoints.Select(s => s.Id).ToList(),
                FinalLocationId = selectedFinalLocationId,
                MileageStart = mileageStart,
                MileageEnd = mileageEnd,
                UploadedFiles = uploadedFiles.Any() ? uploadedFiles : null,
                Remarks = remarks
            };
            var (success, error) = await ExecService.SaveRecordAsync(request);
            if (!success) { errorMessage = error; return; }

            saved = true;
        }
        catch (Exception ex) { errorMessage = "保存失败，请稍后重试或联系管理员"; Logger.LogError(ex, "补登借车记录失败 VehicleId={Id}", VehicleId); }
        finally { saving = false; }
    }

    private async Task ResetAsync()
    {
        saved = false;
        selectedDeptId = 0;
        selectedPersonnelId = 0;
        selectedFinalLocationId = 0;
        selectedWaypoints = new();
        filteredPersonnel = new();
        // 继续登记：预填值按当前车辆重新计算，不沿用上一轮的旧值
        mileageStart = await ExecService.GetLastMileageEndAsync(VehicleId);
        mileageEnd = null;
        remarks = "";
        uploadedFiles = new();
    }
}
