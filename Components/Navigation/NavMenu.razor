@using vehicleManagement.DAL.Model
@using Microsoft.AspNetCore.Components.Authorization

<aside class="sidebar @(IsOpen ? "open" : "")">
    <div class="sidebar-brand">
        <div class="brand-icon">V</div>
        <span class="brand-name">车辆管理</span>
    </div>

    <nav class="sidebar-nav">
        @* 菜单显隐只是 UX，权限判定 100% 在 [Authorize] + BLL 部门隔离两层 *@
        <div class="nav-section">
            <div class="nav-section-title">主菜单</div>

            <AuthorizeView Roles="@Roles.Admin">
                <Authorized>
                    <NavLink href="" Match="NavLinkMatch.All" class="nav-item">
                        <span class="nav-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="9" rx="1"/><rect x="14" y="3" width="7" height="5" rx="1"/><rect x="14" y="12" width="7" height="9" rx="1"/><rect x="3" y="16" width="7" height="5" rx="1"/></svg></span>
                        <span class="nav-label">首页看板</span>
                    </NavLink>
                </Authorized>
            </AuthorizeView>

            <AuthorizeView Roles="@Roles.Admin">
                <Authorized>
                    <NavLink href="departments" class="nav-item">
                        <span class="nav-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87"/><path d="M16 3.13a4 4 0 010 7.75"/></svg></span>
                        <span class="nav-label">部门管理</span>
                    </NavLink>
                </Authorized>
            </AuthorizeView>

            <AuthorizeView Roles="@Roles.BackOffice">
                <Authorized>
                    <NavLink href="personnel" class="nav-item">
                        <span class="nav-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/><circle cx="12" cy="7" r="4"/></svg></span>
                        <span class="nav-label">人员管理</span>
                    </NavLink>
                </Authorized>
            </AuthorizeView>

            <AuthorizeView Roles="@Roles.BackOffice">
                <Authorized>
                    <NavLink href="vehicles" class="nav-item">
                        <span class="nav-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 17h14M5 17a2 2 0 01-2-2V7a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2M5 17l-1 3h16l-1-3"/><circle cx="7.5" cy="17" r="1.5"/><circle cx="16.5" cy="17" r="1.5"/></svg></span>
                        <span class="nav-label">车辆管理</span>
                    </NavLink>
                </Authorized>
            </AuthorizeView>

            <AuthorizeView Roles="@Roles.Admin">
                <Authorized>
                    <NavLink href="locations" class="nav-item">
                        <span class="nav-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg></span>
                        <span class="nav-label">地点管理</span>
                    </NavLink>
                </Authorized>
            </AuthorizeView>

            <AuthorizeView Roles="@Roles.BackOffice">
                <Authorized>
                    <NavLink href="usage-records" class="nav-item">
                        <span class="nav-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg></span>
                        <span class="nav-label">使用记录</span>
                    </NavLink>
                </Authorized>
            </AuthorizeView>

            <AuthorizeView Roles="@Roles.Admin">
                <Authorized>
                    <NavLink href="maintenance-records" class="nav-item">
                        <span class="nav-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a4 4 0 105.6 5.6l-1.4 1.4a3 3 0 01-4.2 0l-1.4-1.4a3 3 0 010-4.2l1.4-1.4z"/><path d="M9 15l-6 6"/></svg></span>
                        <span class="nav-label">维修记录</span>
                    </NavLink>
                </Authorized>
            </AuthorizeView>
        </div>

        <AuthorizeView Roles="@Roles.Admin">
            <Authorized>
                <div class="nav-section">
                    <div class="nav-section-title">AI 服务</div>

                    <NavLink href="ai-chat" class="nav-item">
                        <span class="nav-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/></svg></span>
                        <span class="nav-label">AI 助手</span>
                    </NavLink>
                </div>
            </Authorized>
        </AuthorizeView>
    </nav>

    <div class="sidebar-user">
        <AuthorizeView>
            <Authorized>
                <span class="sidebar-user-name">@context.User.Identity.Name</span>
            </Authorized>
        </AuthorizeView>
        <button type="button" class="logout-trigger sidebar-logout" @onclick="OnLogout">退出登录</button>
    </div>
</aside>

@code {
    [Parameter] public bool IsOpen { get; set; }

    [Parameter] public EventCallback OnLogout { get; set; }
}
